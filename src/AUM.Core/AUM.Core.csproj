<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>AUM.Core</RootNamespace>
    <AssemblyName>AUM.Core</AssemblyName>
    <Version>1.0.0</Version>
    <Authors>The Dental Alliance</Authors>
    <Description>Auto Unit Matcher Core Library - Business logic and engine integration</Description>
  </PropertyGroup>

  <!-- Allow test project to access internal types -->
  <ItemGroup>
    <InternalsVisibleTo Include="AUM.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="8.0.0" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="8.0.0" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="8.0.0" />
    <PackageReference Include="Microsoft.ML.OnnxRuntime" Version="1.24.2" />
  </ItemGroup>

  <!-- ML Models Output Preservation -->
  <ItemGroup>
    <Content Include="..\..\tools\v2_training\out\aum_backbone.onnx" Link="aum_backbone.onnx" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\tools\v2_training\out\aum_matcher.onnx" Link="aum_matcher.onnx" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- Copy native DLL and dependencies to output on build -->
  <ItemGroup>
    <!-- Main engine DLL -->
    <None Include="../AUM.Engine/build/bin/Release/AUM.Engine.dll" CopyToOutputDirectory="PreserveNewest" Condition="Exists('../AUM.Engine/build/bin/Release/AUM.Engine.dll')" />
    
    <!-- PCL dependencies -->
    <None Include="../AUM.Engine/build/bin/Release/pcl_*.dll" CopyToOutputDirectory="PreserveNewest" />
    
    <!-- FAISS dependency -->
    <None Include="../AUM.Engine/build/bin/Release/faiss.dll" CopyToOutputDirectory="PreserveNewest" Condition="Exists('../AUM.Engine/build/bin/Release/faiss.dll')" />
    
    <!-- Other dependencies (BLAS, etc.) -->
    <None Include="../AUM.Engine/build/bin/Release/*.dll" CopyToOutputDirectory="PreserveNewest" />
    
    <!-- Migration SQL files -->
    <None Include="Data/Migrations/*.sql" CopyToOutputDirectory="PreserveNewest" Link="Data/Migrations/%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
