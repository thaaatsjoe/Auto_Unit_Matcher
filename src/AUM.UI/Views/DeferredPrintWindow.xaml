<Window x:Class="AUM.UI.Views.DeferredPrintWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Deferred Print Queue" 
        Height="400" Width="500"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BackgroundBrush}">
    
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        
        <!-- Header -->
        <TextBlock Grid.Row="0" 
                   Text="Deferred Print Queue" 
                   FontSize="20" 
                   FontWeight="Bold"
                   Margin="0,0,0,16" />
        
        <!-- Add Case -->
        <Grid Grid.Row="1" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            
            <TextBlock Text="Case number:" 
                       VerticalAlignment="Center"
                       Margin="0,0,8,0" />
            <TextBox Grid.Column="1" 
                     Text="{Binding NewCaseNumber, UpdateSourceTrigger=PropertyChanged}"
                     Padding="8,4" />
            <Button Grid.Column="2" 
                    Content="Add" 
                    Command="{Binding AddCaseCommand}"
                    Margin="8,0,0,0" />
        </Grid>
        
        <!-- Queue List -->
        <Border Grid.Row="2" 
                Background="{DynamicResource SurfaceBrush}"
                CornerRadius="4"
                Padding="8">
            <ListBox ItemsSource="{Binding QueuedCases}"
                     Background="Transparent"
                     BorderThickness="0">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="•" Margin="0,0,8,0" />
                            <TextBlock Text="{Binding CaseId}" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding AddedTime, StringFormat=' (added {0:HH:mm})'}" 
                                       Foreground="{DynamicResource TextSecondaryBrush}" />
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Border>
        
        <!-- Actions -->
        <StackPanel Grid.Row="3" 
                    Orientation="Horizontal" 
                    HorizontalAlignment="Right"
                    Margin="0,16,0,0">
            <Button Content="Print All" 
                    Command="{Binding PrintAllCommand}"
                    Margin="0,0,8,0" />
            <Button Content="Clear Queue" 
                    Command="{Binding ClearQueueCommand}"
                    Margin="0,0,8,0" />
            <Button Content="Close" 
                    Click="CloseButton_Click" />
        </StackPanel>
    </Grid>
</Window>
