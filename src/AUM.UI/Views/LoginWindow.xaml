<Window x:Class="AUM.UI.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:AUM.UI.ViewModels"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:LoginViewModel}"
        Title="Auto Unit Matcher - Login" 
        Height="500" Width="450"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="NoResize"
        Background="{DynamicResource BackgroundBrush}">
    
    <Border BorderBrush="{DynamicResource PrimaryBrush}" 
            BorderThickness="2" 
            CornerRadius="8">
        <Grid Margin="32">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            
            <!-- Header -->
            <StackPanel Grid.Row="0" HorizontalAlignment="Center" Margin="0,0,0,32">
                <TextBlock Text="AUTO UNIT MATCHER" 
                           FontSize="24" 
                           FontWeight="Bold"
                           Foreground="{DynamicResource PrimaryBrush}"
                           HorizontalAlignment="Center" />
            </StackPanel>
            
            <!-- Login Form -->
            <StackPanel Grid.Row="1" VerticalAlignment="Center">
                <TextBlock Text="Employee Number:" 
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           Margin="0,0,0,8" />
                
                <TextBox Text="{Binding EmployeeNumber, UpdateSourceTrigger=PropertyChanged}"
                         FontSize="18"
                         Padding="12,8"
                         MaxLength="20">
                    <TextBox.InputBindings>
                        <KeyBinding Key="Enter" Command="{Binding LoginCommand}" />
                    </TextBox.InputBindings>
                </TextBox>
                
                <TextBlock Text="Full Name (for new accounts):" 
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           Margin="0,16,0,8" />
                
                <TextBox Text="{Binding EmployeeName, UpdateSourceTrigger=PropertyChanged}"
                         FontSize="18"
                         Padding="12,8"
                         MaxLength="100">
                    <TextBox.InputBindings>
                        <KeyBinding Key="Enter" Command="{Binding CreateAccountCommand}" />
                    </TextBox.InputBindings>
                </TextBox>
                
                <Button Content="LOG IN"
                        Command="{Binding LoginCommand}"
                        Margin="0,24,0,8"
                        Height="44"
                        FontSize="16"
                        FontWeight="Bold"
                        IsEnabled="{Binding IsLoggingIn, Converter={StaticResource InverseBoolConverter}}" />
                
                <Button Content="CREATE ACCOUNT"
                        Command="{Binding CreateAccountCommand}"
                        Margin="0,0,0,0"
                        Height="44"
                        FontSize="16"
                        FontWeight="Bold"
                        IsEnabled="{Binding IsLoggingIn, Converter={StaticResource InverseBoolConverter}}" />
            </StackPanel>
            
            <!-- Status -->
            <Border Grid.Row="2" 
                    Background="{DynamicResource SurfaceBrush}"
                    CornerRadius="4"
                    Padding="12,8">
                <TextBlock Text="{Binding StatusMessage}"
                           HorizontalAlignment="Center">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsError}" Value="True">
                                    <Setter Property="Foreground" Value="{DynamicResource ErrorBrush}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Border>
        </Grid>
    </Border>
</Window>
