<Window x:Class="AUM.UI.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Settings" 
        Height="500" Width="600"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BackgroundBrush}">
    
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        
        <!-- Header -->
        <TextBlock Grid.Row="0" 
                   Text="Settings" 
                   FontSize="20" 
                   FontWeight="Bold"
                   Margin="0,0,0,16" />
        
        <!-- Settings Panel -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <!-- Paths Section -->
                <TextBlock Text="Paths" FontWeight="Bold" FontSize="14" Margin="0,0,0,8" />
                <Border Background="{DynamicResource SurfaceBrush}" CornerRadius="4" Padding="12" Margin="0,0,0,16">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        
                        <TextBlock Text="STL Root Path:" VerticalAlignment="Center" Margin="0,0,8,8" />
                        <TextBox Grid.Column="1" Text="{Binding StlRootPath}" Padding="8,4" Margin="0,0,8,8" />
                        <Button Grid.Column="2" Content="Browse..." Command="{Binding BrowseStlPathCommand}" Margin="0,0,0,8" />
                        
                        <TextBlock Grid.Row="1" Text="Database Path:" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding DatabasePath}" Padding="8,4" IsReadOnly="True" />
                    </Grid>
                </Border>
                
                <!-- Matching Section -->
                <TextBlock Text="Matching" FontWeight="Bold" FontSize="14" Margin="0,0,0,8" />
                <Border Background="{DynamicResource SurfaceBrush}" CornerRadius="4" Padding="12" Margin="0,0,0,16">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        
                        <TextBlock Text="Confidence Threshold (%):" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <Slider Grid.Column="1" 
                                Minimum="50" Maximum="99" 
                                Value="{Binding ConfidenceThreshold}"
                                TickFrequency="5" 
                                IsSnapToTickEnabled="True" />
                    </Grid>
                </Border>
                
                <!-- Audio Section -->
                <TextBlock Text="Audio" FontWeight="Bold" FontSize="14" Margin="0,0,0,8" />
                <Border Background="{DynamicResource SurfaceBrush}" CornerRadius="4" Padding="12" Margin="0,0,0,16">
                    <CheckBox Content="Enable audio feedback" IsChecked="{Binding AudioEnabled}" />
                </Border>
                
                <!-- Backup Section -->
                <TextBlock Text="Backup" FontWeight="Bold" FontSize="14" Margin="0,0,0,8" />
                <Border Background="{DynamicResource SurfaceBrush}" CornerRadius="4" Padding="12">
                    <StackPanel Orientation="Horizontal">
                        <Button Content="Create Backup" Command="{Binding CreateBackupCommand}" Margin="0,0,8,0" />
                        <Button Content="Restore Backup" Command="{Binding RestoreBackupCommand}" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
        
        <!-- Actions -->
        <StackPanel Grid.Row="2" 
                    Orientation="Horizontal" 
                    HorizontalAlignment="Right"
                    Margin="0,16,0,0">
            <Button Content="Save" 
                    Command="{Binding SaveCommand}"
                    Margin="0,0,8,0" />
            <Button Content="Cancel" 
                    Click="CancelButton_Click" />
        </StackPanel>
    </Grid>
</Window>
