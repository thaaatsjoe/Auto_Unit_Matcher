<Window x:Class="AUM.UI.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:AUM.UI.ViewModels"
        xmlns:controls="clr-namespace:AUM.UI.Controls"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:MainViewModel}"
        Title="Auto Unit Matcher" 
        Height="800" Width="1200"
        WindowState="Maximized"
        Background="{DynamicResource BackgroundBrush}">
    
    <!-- Keyboard Shortcuts per PRD -->
    <Window.InputBindings>
        <KeyBinding Key="Enter" Command="{Binding ConfirmMatchCommand}" />
        <KeyBinding Key="Escape" Command="{Binding RejectMatchCommand}" />
        <KeyBinding Key="S" Command="{Binding OpenSettingsCommand}" />
        <KeyBinding Key="M" Command="{Binding OpenManualLookupCommand}" />
        <KeyBinding Key="H" Command="{Binding ShowHelpCommand}" />
        <KeyBinding Key="OemQuestion" Command="{Binding ShowHelpCommand}" />
    </Window.InputBindings>
    
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />  <!-- Header -->
            <RowDefinition Height="*" />     <!-- Main Content -->
            <RowDefinition Height="Auto" />  <!-- Status Bar -->
        </Grid.RowDefinitions>
        
        <!-- Header -->
        <Border Grid.Row="0" 
                Background="{DynamicResource PrimaryBrush}" 
                Padding="16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Auto Unit Matcher" 
                               FontSize="24" 
                               FontWeight="Bold" 
                               Foreground="White" />
                </StackPanel>
                
                <StackPanel Grid.Column="1" 
                            Orientation="Horizontal" 
                            VerticalAlignment="Center"
                            Margin="0,0,12,0">
                    <TextBlock Text="Operator: " 
                               Foreground="White" 
                               Opacity="0.8" />
                    <TextBlock Text="{Binding OperatorName}" 
                               Foreground="White" 
                               FontWeight="SemiBold" />
                </StackPanel>
                
                <Button Grid.Column="2" 
                        Content="⚙ Settings" 
                        Command="{Binding OpenSettingsCommand}"
                        Background="Transparent" 
                        Foreground="White" 
                        BorderBrush="White" 
                        BorderThickness="1"
                        Padding="12,6"
                        Cursor="Hand"
                        ToolTip="Open Settings (S)" />
            </Grid>
        </Border>
        
        <!-- Main Content Area -->
        <Grid Grid.Row="1" Margin="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*" />  <!-- 3D Viewer -->
                <ColumnDefinition Width="16" />  <!-- Spacing -->
                <ColumnDefinition Width="*" />   <!-- Match Results -->
            </Grid.ColumnDefinitions>
            
            <!-- Left: 3D Viewer Area -->
            <Border Grid.Column="0" 
                    Background="{DynamicResource SurfaceBrush}" 
                    CornerRadius="8">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    
                    <!-- 3D Viewer Control -->
                    <controls:StlViewerControl Grid.Row="0" 
                                               DataContext="{Binding StlViewerViewModel}"
                                               Margin="8"/>
                    
                    <!-- Action Buttons -->
                    <StackPanel Grid.Row="1" 
                                Orientation="Horizontal" 
                                HorizontalAlignment="Center"
                                Margin="0,0,0,16">
                        <Button Content="CONFIRM" 
                                Command="{Binding ConfirmMatchCommand}"
                                Width="120" Height="40"
                                Margin="8,0"
                                FontWeight="Bold"
                                Background="#4CAF50"
                                Foreground="White"
                                IsEnabled="{Binding SelectedMatch, Converter={StaticResource NotNullToBoolConverter}}" />
                        <Button Content="REJECT" 
                                Command="{Binding RejectMatchCommand}"
                                Width="120" Height="40"
                                Margin="8,0"
                                FontWeight="Bold"
                                Background="#F44336"
                                Foreground="White"
                                IsEnabled="{Binding SelectedMatch, Converter={StaticResource NotNullToBoolConverter}}" />
                        <!-- Testing button -->
                        <Button Content="LOAD TEST STL" 
                                Command="{Binding LoadTestStlCommand}"
                                Width="140" Height="40"
                                Margin="16,0,8,0"
                                FontWeight="Bold"
                                Background="#2196F3"
                                Foreground="White"
                                ToolTip="Load an STL file for testing (Development)" />
                    </StackPanel>
                </Grid>
            </Border>
            
            <!-- Right: Match Results Panel -->
            <Border Grid.Column="2" 
                    Background="{DynamicResource SurfaceBrush}" 
                    CornerRadius="8"
                    Padding="16">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    
                    <!-- Header -->
                    <TextBlock Grid.Row="0" 
                               Text="TOP 5 MATCHES" 
                               FontSize="16" 
                               FontWeight="Bold"
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               Margin="0,0,0,16" />
                    
                    <!-- Match List -->
                    <ListBox Grid.Row="1"
                             ItemsSource="{Binding MatchResults}"
                             SelectedItem="{Binding SelectedMatch}"
                             Background="Transparent"
                             BorderThickness="0">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Padding="8" Margin="0,2">
                                    <StackPanel>
                                        <TextBlock Text="{Binding DisplayText}" 
                                                   FontSize="14"
                                                   FontWeight="SemiBold" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    
                    <!-- Selected Match Details -->
                    <Border Grid.Row="2" 
                            Margin="0,16,0,0"
                            Padding="8"
                            Background="{DynamicResource BackgroundBrush}"
                            CornerRadius="4"
                            Visibility="{Binding SelectedMatch, Converter={StaticResource NotNullToVisibilityConverter}}">
                        <StackPanel>
                            <TextBlock Text="Selected Match" 
                                       FontWeight="Bold" 
                                       Margin="0,0,0,8" />
                            <TextBlock>
                                <Run Text="Case: " />
                                <Run Text="{Binding SelectedMatch.CaseId}" FontWeight="SemiBold" />
                            </TextBlock>
                            <TextBlock>
                                <Run Text="Confidence: " />
                                <Run Text="{Binding SelectedMatch.Confidence, StringFormat='{}{0:F1}%'}" FontWeight="SemiBold" />
                            </TextBlock>
                        </StackPanel>
                    </Border>
                    
                    <!-- Empty State -->
                    <TextBlock Grid.Row="1"
                               Text="Awaiting scan..."
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               Visibility="{Binding MatchResults.Count, Converter={StaticResource ZeroToVisibilityConverter}}" />
                </Grid>
            </Border>
        </Grid>
        
        <!-- Status Bar -->
        <Border Grid.Row="2" 
                Background="{DynamicResource SurfaceBrush}" 
                Padding="8,4">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                
                <TextBlock Text="{Binding StatusText}" 
                           Foreground="{DynamicResource TextSecondaryBrush}" />
                
                <TextBlock Grid.Column="1" 
                           Foreground="{DynamicResource TextSecondaryBrush}" 
                           Margin="16,0">
                    <Run Text="Database: " />
                    <Run Text="{Binding UnitCount}" />
                    <Run Text=" units" />
                </TextBlock>
                
                <TextBlock Grid.Column="2" 
                           Text="v1.0.0" 
                           Foreground="{DynamicResource TextSecondaryBrush}" />
            </Grid>
        </Border>
    </Grid>
</Window>
