<Window x:Class="AUM.UI.Views.ExtractionFailuresWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Extraction Failures" 
        Height="450" Width="700"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BackgroundBrush}">
    
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        
        <!-- Header -->
        <TextBlock Grid.Row="0" 
                   Text="Extraction Failures" 
                   FontSize="20" 
                   FontWeight="Bold"
                   Margin="0,0,0,16" />
        
        <!-- Failures List -->
        <DataGrid Grid.Row="1"
                  ItemsSource="{Binding Failures}"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  SelectionMode="Extended"
                  Background="{DynamicResource SurfaceBrush}">
            <DataGrid.Columns>
                <DataGridTextColumn Header="File" Binding="{Binding FileName}" Width="2*" />
                <DataGridTextColumn Header="Error" Binding="{Binding ErrorMessage}" Width="2*" />
                <DataGridTextColumn Header="Time" Binding="{Binding Timestamp, StringFormat='{}{0:HH:mm}'}" Width="Auto" />
            </DataGrid.Columns>
        </DataGrid>
        
        <!-- Actions -->
        <StackPanel Grid.Row="2" 
                    Orientation="Horizontal" 
                    HorizontalAlignment="Right"
                    Margin="0,16,0,0">
            <Button Content="Retry All" 
                    Command="{Binding RetryAllCommand}"
                    Margin="0,0,8,0" />
            <Button Content="Retry Selected" 
                    Command="{Binding RetrySelectedCommand}" 
                    Margin="0,0,8,0" />
            <Button Content="Clear Resolved" 
                    Command="{Binding ClearResolvedCommand}"
                    Margin="0,0,8,0" />
            <Button Content="Close" 
                    Click="CloseButton_Click" />
        </StackPanel>
    </Grid>
</Window>
