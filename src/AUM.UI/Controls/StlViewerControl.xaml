<UserControl x:Class="AUM.UI.Controls.StlViewerControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:hx="clr-namespace:HelixToolkit.Wpf;assembly=HelixToolkit.Wpf"
             mc:Ignorable="d"
             d:DesignHeight="400" d:DesignWidth="600"
             Background="#1E1E1E">
    
    <Grid>
        <!-- 3D Viewport using standard HelixToolkit.Wpf -->
        <hx:HelixViewport3D
            x:Name="Viewport"
            ZoomExtentsWhenLoaded="True"
            ShowCoordinateSystem="True"
            Background="#1E1E1E">
            
            <!-- Lighting -->
            <hx:DefaultLights/>
            
            <!-- Model Container - bind to Model property -->
            <ModelVisual3D Content="{Binding Model}" />
            
        </hx:HelixViewport3D>
        
        <!-- Loading overlay -->
        <Border Background="#CC1E1E1E"
                Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <TextBlock Text="Loading STL Model..." 
                           Foreground="White" 
                           FontSize="18"
                           FontWeight="SemiBold"
                           HorizontalAlignment="Center" />
                <TextBlock Text="Please wait while geometry is rendered"
                           Foreground="#AAAAAA"
                           FontSize="12"
                           Margin="0,8,0,0"
                           HorizontalAlignment="Center" />
            </StackPanel>
        </Border>
        
        <!-- Empty state -->
        <Border Background="Transparent"
                Visibility="{Binding HasModel, Converter={StaticResource InverseVisibilityConverter}}">
            <TextBlock Text="No STL file currently loaded"
                       Foreground="#888888"
                       FontSize="16"
                       FontStyle="Italic"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center" />
        </Border>
    </Grid>
</UserControl>
